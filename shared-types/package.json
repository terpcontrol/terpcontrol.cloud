{
  "license": "Apache-2.0",
  "name": "@fg2/shared-types",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs"
  },
  "exports": {
    "./v1": {
      "types": "./v1.d.ts",
      "default": "./v1.js"
    },
    "./v1-schemas": {
      "types": "./v1-schemas/index.d.ts",
      "default": "./v1-schemas/index.js"
    },
    "./v1-schemas/*.js": {
      "types": "./v1-schemas/*.d.ts",
      "default": "./v1-schemas/*.js"
    },
    "./openapi-schemas.json": "./openapi-schemas.json"
  },
  "dependencies": {
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3"
  }
}
