        "type": "string"
      },
      "page": {
        "$ref": "#/components/schemas/SharePage"
      },
      "editable": {
        "type": "boolean",
        "description": "Visitors may change the view (time frame, measures, filters, webcam)."
      },
      "webcam": {
        "type": "boolean",
        "description": "Visitors may load webcam images/timelapses (diary photos are always visible)."
      },
      "charts": {
        "description": "Diary links: visitors may open the chart views linked from the grow report.",
        "type": "boolean"
      },
      "query": {
        "description": "Query string capturing the shared view (time frame, measures, filters).",
        "type": "string"
      },
      "createdAt": {
        "type": "number"
      },
      "expiresAt": {
        "description": "Epoch ms; null means the link never expires.",
        "type": [
          "number",
          "null"
        ]
      },
      "revokedAt": {
        "type": [
          "number",
          "null"
        ]
      },
      "openCount": {
        "type": "number"
      },
