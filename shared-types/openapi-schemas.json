{
  "Alarm": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "disabled": {
        "type": "boolean"
      },
      "alarmId": {
        "type": "string"
      },
      "sensorType": {
        "type": "string"
      },
