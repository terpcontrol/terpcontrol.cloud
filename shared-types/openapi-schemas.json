        "type": "boolean"
      },
      "lastTriggeredAt": {
        "type": "number"
      },
      "lastResolvedAt": {
        "type": "number"
      },
      "retriggerSeconds": {
        "type": "number"
      },
      "extremeValue": {
        "type": "number"
      },
      "latestDataPointTime": {
        "type": "number"
      },
      "webhookMethod": {
        "type": "string",
        "enum": [
          "GET",
          "POST",
          "PUT"
        ]
      },
      "webhookHeaders": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "webhookTriggeredPayload": {
        "type": "string"
      },
      "webhookResolvedPayload": {
        "type": "string"
      },
      "thresholdSeconds": {
        "type": "number"
      },
      "reportWebhookErrors": {
        "type": "boolean"
      },
      "tunnelWebhook": {
        "type": "boolean"
      }
    },
    "required": [
      "alarmId",
      "sensorType",
      "actionType",
      "actionTarget"
    ]
  },
  "FirmwareSettings": {
    "type": "object",
    "properties": {
      "autoUpdate": {
        "description": "@deprecated",
        "type": "boolean"
      }
    }
  },
  "FirmwareChannel": {
    "type": "string",
    "enum": [
      "stable",
      "beta",
      "alpha",
