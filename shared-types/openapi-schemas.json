  },
  "WebcamModel": {
    "type": "string",
    "enum": [
      "terp_cam",
      "tapo_c200",
      "reolink",
      "hikvision",
      "custom"
    ],
    "description": "Which camera the webcam stream URL was built for. 'terp_cam' is the Terp Control Cam (URL reported by the device via hardware-info after local pairing); brand values are RTSP URL templates; 'custom' is a raw URL. Only a presentation hint - the stream itself is always cloudSettings.rtspStream."
  },
  "CloudSettings": {
    "type": "object",
    "properties": {
      "autoFirmwareUpdate": {
        "description": "@deprecated Use firmwareChannel: 'manual' to disable automatic updates. Kept for reading legacy devices.",
