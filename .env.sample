########################################################################################################################
#
# InfluxDB Configuration
# (For storing time-series data)
#
########################################################################################################################

INFLUXDB_USERNAME=plantalytix
INFLUXDB_PASSWORD=CHANGEME
INFLUXDB_ORG=plantalytix
INFLUXDB_BUCKET=plantalytix
INFLUXDB_TOKEN=CHANGEME

# Leave this as it is, unless you want to access InfluxDB from another machine
INFLUXDB_PORT_EXTERNAL=127.0.0.1:8086

# To access InfluxDB from another machine, uncomment the following
#INFLUXDB_PORT_EXTERNAL=8086


########################################################################################################################
#
# MongoDB Configuration
# (For storing application data like users and devices)
#
########################################################################################################################

MONGODB_ADMINUSERNAME=plantalytix
MONGODB_DATABASE=flexogrow
MONGODB_ADMINPASSWORD=CHANGEME

# Uncomment the following line if your CPU doesn't support AVX instructions (e.g. older CPUs). Then you
# will use the older MongoDB 4.4 version which doesn't require AVX yet.
#DOCKER_MONGODB_IMAGE=mongo:4.4.25

########################################################################################################################
#
# Mongo-Express Configuration
# (Web-based MongoDB admin interface)
#
########################################################################################################################

# Leave this as it is, as mongo-express can be accessed with default credentials
MONGOEXPRESS_PORT_EXTERNAL=127.0.0.1:8088

# To access mongo-express from another machine, uncomment the following
#MONGOEXPRESS_PORT_EXTERNAL=8088

# HTTP basic-auth credentials guarding the mongo-express web UI
MONGOEXPRESS_USERNAME=admin
MONGOEXPRESS_PASSWORD=pass


########################################################################################################################
#
# MQTT Broker Configuration
# (The device connects to this broker to send/receive data. Therefore this needs to be accessible by other hosts.)
#
########################################################################################################################

# The IP should be the address of the host machine running the Docker containers. Also it should be accessible by the device.
MQTT_HOST_EXTERNAL=192.168.0.100

# Do not use the format <IP_ADDRESS>:<PORT> here, this is not supported.
# Plaintext MQTT port. Kept for legacy firmware that cannot speak TLS.
MQTT_PORT_EXTERNAL=1883

# Encrypted MQTT (MQTTS) port. The TLS listener is only enabled when the cert/key
# values below are set; otherwise only the plaintext listener above runs.
MQTTS_PORT_EXTERNAL=8883

# MQTTS broker server cert/key and the CA the firmware trusts, as base64-encoded PEM.
# Leave empty to run with the plaintext listener only. Run `./scripts/setup-mqtts.sh`
# to generate a CA + server cert (CN/SAN = MQTT_HOST_EXTERNAL above) and have all three
# written here in place; it prints the CA private key once for safekeeping. build-fw.sh
# reads MQTTS_CA_PEM_B64 to bake the CA into the firmware. Re-run the script to rotate
# the server cert under the same CA without touching deployed devices.
MQTTS_CERT_PEM_B64=
MQTTS_KEY_PEM_B64=
MQTTS_CA_PEM_B64=

# Leave this as it is, as the management interface can be accessed with default credentials
MQTT_MANAGEMENT_PORT_EXTERNAL=127.0.0.1:8072


########################################################################################################################
#
# server Configuration
# (Backend API service - the 'server' compose service)
#
########################################################################################################################

# The following URL should be the address of the host machine running the Docker containers. Also it should be
# accessible by the device.
API_URL_EXTERNAL=http://192.168.0.100:8081

# The API port that the backend is running on. In most cases, this needs to match the port in the API_URL_EXTERNAL.
API_PORT_EXTERNAL=8081

# This is used to sign the authentication tokens. Change this to a strong random value.
TOKEN_SECRET_KEY=CHANGEME

# This token is used for automating tasks like uploading a new firmware. Change this to a strong random value.
AUTOMATION_TOKEN=CHANGEME

# Shared secret that RabbitMQ presents to the server on every MQTT auth request.
MQTTAUTH_SHARED_SECRET=CHANGEME


########################################################################################################################
#
# webapp Configuration
# (Frontend web application - the 'webapp' compose service)
#
########################################################################################################################

# This is the port, that you will need to enter in your browser to access the web application. You can set this to 80
# if you want to access it without specifying a port.
WEBAPP_PORT_EXTERNAL=8080

# The server fetches camera stills itself, which needs a way to find a camera
# sitting on somebody else's network. That is what the manufacturer's rendezvous
# servers do; they are not shipped in the source, so set them here to enable it.
# Left empty, each controller relays its own camera's images instead - which
# works, at 640x360 and lower reliability.
#
# The lookup happens ONCE per camera, not once per image: the path punched
# through is then held open with a keepalive and reused.
TERPCAM_RENDEZVOUS_HOSTS=

# Only when this stack runs on the cameras' own network: the host's address
# there, so cameras punch at the host rather than at the container's bridge
# address. Defaults to MQTT_HOST_EXTERNAL, which is already that address on such
# a stack, so it usually needs no value. Only a private address is used - a
# hosted server advertises nothing, which is correct for it.
TERPCAM_ADVERTISE_ADDRESS=

# Host ports the camera traffic is published on: one port is held per camera
# being served, so the range has to be at least as wide as the number of
# cameras. Change the numbers if the range is already taken - two stacks on one
# machine, say - or widen it for a larger fleet.
#
# The container is given the same numbers, because it has to be the same range
# on both sides. The camera replies to the port its packet came from and the
# bridge keeps the container's source port, so a host port that differed from
# the container's would receive nothing: captures would fall back to the
# controller (640x360, less reliable) with nothing in the log to say why.
# Measured: equal ranges 3/3, mismatched 0/3.
TERPCAM_P2P_PORTS_EXTERNAL_START=32200
TERPCAM_P2P_PORTS_EXTERNAL_END=32209

# The default admin user credentials for the web application.
ADMINUSER_USERNAME=admin
ADMINUSER_PASSWORD=CHANGEME


########################################################################################################################
#
# Email Configuration
# (Optional - for sending alarm or registration emails)
#
########################################################################################################################

# Set to true, if users should confirm their email address during registration.
REQUIRE_ACTIVATION=false

SMTP_SENDER=""
SMTP_SERVER=""
SMTP_PORT=465
SMTP_USER=""
SMTP_SECURE=false
SMTP_PASSWORD=""


########################################################################################################################
#
# Self-Registration Configuration
#
########################################################################################################################

# Set to false, to allow no more modules to connect to your server. ("Change server" will fail, if set to false.)
ENABLE_SELF_REGISTRATION=true

# The password that you need to input on the device during the change server process.
SELF_REGISTRATION_PASSWORD=CHANGEME


########################################################################################################################
#
# AI specific configuration (only needed during development)
#
########################################################################################################################

# Credentials for the agent testing service - ideally with devices configured
AGENT_TESTING_USERNAME=
AGENT_TESTING_PASSWORD=


########################################################################################################################
#
# Garmin Connect IQ Configuration
# (Only needed to build the watch app in garmin/ - see "Garmin viewer app" in README.md)
#
########################################################################################################################

# Garmin developer account. Garmin only serves the per-device compiler definitions to a logged-in
# account, so the first build needs these. They are not required for the app itself.
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Set to 1 to confirm you accept the Garmin Connect IQ SDK License Agreement:
# https://developer.garmin.com/downloads/connect-iq/sdks/agreement.html
GARMIN_SDK_AGREEMENT_ACCEPTED=

# Base64 of your Connect IQ developer key in DER form. The store binds an app id to the key it was
# first published with, so a .iq you intend to upload must be signed with the same key every time.
# Generate one with:
#   openssl genrsa -out developer_key.pem 4096
#   openssl pkcs8 -topk8 -inform PEM -outform DER -in developer_key.pem -out developer_key.der -nocrypt
#   base64 -w0 developer_key.der
# Keep developer_key.der backed up somewhere safe - losing it means losing the ability to publish updates.
GARMIN_DEVELOPER_KEY_B64=
