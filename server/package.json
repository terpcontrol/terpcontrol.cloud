{
  "name": "user-auth",
  "version": "0.0.0",
  "description": "TypeScript + NestJS + Fastify + Mongoose + MongoDB API server",
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "start": "rm -rf dist; npm run build && cross-env NODE_ENV=production node dist/main.js",
    "dev": "cross-env NODE_ENV=development nodemon --verbose",
    "build": "swc src -d dist --source-maps --copy-files",
    "build:tsc": "tsc && tsc-alias",
    "test": "npm run --silent test:unit && npm run --silent test:integration",
    "test:unit": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "migrate": "node dist/migrations/cli.js",
    "migrate:check": "node dist/migrations/cli.js --check",
    "lint": "eslint src/ test/",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fg2/shared-types": "file:../shared-types",
    "@fontsource/inter": "^5.3.0",
    "@influxdata/influxdb-client": "^1.33.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.1.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.0",
    "@types/luxon": "^3.3.0",
    "@types/range-parser": "^1.2.7",
    "async-mutex": "^0.5.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^10.0.0",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.3.0",
    "mongoose": "^8.22.1",
    "mqtt": "^4.3.7",
    "nodemailer": "^10.0.14",
    "p-limit": "^3.1.0",
    "range-parser": "^1.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.5.5",
    "sharp": "^0.35.5",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^4.5.5",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.51",
    "@swc/core": "^1.2.108",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/supertest": "^2.0.11",
    "aedes": "^1.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^7.0.1",
    "jest": "^29.7.0",
    "lint-staged": "^11.0.0",
    "mongodb-memory-server": "^11.2.0",
    "node-config": "^0.0.2",
    "node-gyp": "^8.1.0",
    "nodemon": "^2.0.9",
    "prettier": "^3.9.6",
    "smtp-server": "^3.19.3",
    "supertest": "^6.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.4.1",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "mongodb-memory-server@11.2.0": true,
    "@scarf/scarf": false,
    "fsevents": false,
    "nodemon": false
  }
}
