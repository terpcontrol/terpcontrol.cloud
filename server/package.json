{
  "name": "user-auth",
  "version": "0.0.0",
  "description": "TypeScript + NestJS + Fastify + Mongoose + MongoDB API server",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "rm -rf dist; npm run build && cross-env NODE_ENV=production node dist/nest/main.js",
    "dev": "cross-env NODE_ENV=development nodemon --verbose",
    "build": "swc src -d dist --source-maps --copy-files",
    "build:tsc": "tsc && tsc-alias",
    "test": "jest --config jest.integration.config.js",
    "lint": "eslint --ignore-path .gitignore --ext .ts src/",
    "lint:fix": "npm run lint -- --fix",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fg2/shared-types": "file:../shared-types",
    "@influxdata/influxdb-client": "^1.33.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.0",
    "@types/luxon": "^3.3.0",
    "async-mutex": "^0.5.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^10.0.0",
    "envalid": "^7.1.0",
    "imagemagick": "^0.1.3",
    "influx": "^5.9.3",
    "jsonwebtoken": "^8.5.1",
    "luxon": "^3.3.0",
    "mongoose": "^8.22.1",
    "mqtt": "^4.3.7",
    "nodemailer": "^8.0.5",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^4.5.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.51",
    "@swc/core": "^1.2.108",
    "@types/bcrypt": "^5.0.0",
    "@types/imagemagick": "^0.0.35",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^8.5.4",
    "@types/node": "^20.19.41",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^4.28.2",
    "@typescript-eslint/parser": "^4.28.2",
    "aedes": "^1.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^7.30.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "husky": "^7.0.1",
    "jest": "^29.7.0",
    "lint-staged": "^11.0.0",
    "mongodb-memory-server": "^11.2.0",
    "node-config": "^0.0.2",
    "node-gyp": "^8.1.0",
    "nodemon": "^2.0.9",
    "pm2": "^5.1.0",
    "prettier": "^2.3.2",
    "smtp-server": "^3.19.3",
    "supertest": "^6.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.4.1",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^5.9.3"
  }
