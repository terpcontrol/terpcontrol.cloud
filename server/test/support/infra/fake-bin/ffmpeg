#!/usr/bin/env node
'use strict';

/**
 * The ffmpeg the app under test finds on its PATH.
 *
 * It records the arguments of every run and otherwise hands the run straight to
 * the real ffmpeg, so the suite keeps reading actual frames out of actual
 * streams - those on this machine; a stream anywhere else is answered as
 * unreachable (see `unreachable`). A spec that needs a particular camera - one
 * whose parameter sets are not ready yet, one that is unreachable, one that
 * never answers at all, one that should receive specific bytes - arms a plan
 * first (see test/support/ffmpeg.ts) and those runs are answered from it
 * instead.
 *
 * A plan entry is only spent on a run it names (`match`), because the webcam
 * poller reads its own cameras throughout and would otherwise take an answer
 * meant for the spec. Entries are spent in order.
 */

const { spawn } = require('node:child_process');
const { connect } = require('node:net');
const { appendFileSync, existsSync, readFileSync, writeFileSync } = require('node:fs');
const { delimiter, join } = require('node:path');

const args = process.argv.slice(2);
const stateDir = process.env.HARNESS_FFMPEG_STATE;

const input = args.includes('-i') ? args[args.indexOf('-i') + 1] : '';
/** The address the run opens, where it opens one on a network rather than a pipe or a file. */
const stream = URL.canParse(input) && /^(rtsps?|rtmps?|https?|tcp|udp):$/.test(new URL(input).protocol) ? new URL(input) : null;

const onThisMachine = ({ hostname }) => hostname === 'localhost' || hostname === '[::1]' || hostname.startsWith('127.');

/**
 * Nothing the suite runs stands anywhere but on this machine. A camera a spec
 * puts at 10.0.0.30 or 192.168.1.40 is one on somebody's home network, and
 * handed to the real ffmpeg its run would cost whatever the network the suite
 * happens to run on makes of the address: refused at once, a device that
 * really has it, or - on most - the operating system's connect timeout, over a
 * minute in which the run holds one of the few ffmpeg runs the server allows
 * itself at a time. The poller reads every camera that stands, so enough of
 * them fill all of those, and a still a spec asks for then waits behind them
 * until it times out. So such a run is answered at once, in ffmpeg's words -
 * the address quoted back, credentials and all, as the real one quotes it. A
 * spec that wants a camera which never answers arms one (`delayMs`).
 */
const unreachable = () => {
  process.stderr.write(
    `[tcp @ 0x0] Connection to tcp://${stream.host} failed: No route to host\n` +
      '[in#0 @ 0x0] Error opening input: No route to host\n' +
      `Error opening input file ${input}.\n` +
      'Error opening input files: No route to host\n',
  );
  process.exit(1);
};

const delegate = () => {
  if (stream && !onThisMachine(stream)) {
    unreachable();
    return;
  }

  const self = __dirname;
  const real = (process.env.PATH || '')
    .split(delimiter)
    .filter(dir => dir && dir !== self)
    .map(dir => join(dir, 'ffmpeg'))
    .find(candidate => existsSync(candidate));

  if (!real) {
    process.stderr.write('harness: no real ffmpeg on PATH behind the shim\n');
    process.exit(127);
  }

  // Inherited rather than piped: a still comes back on stdout as JPEG bytes.
  const child = spawn(real, args, { stdio: 'inherit' });

  // The server runs ffmpeg with a timeout, and killing the shim would otherwise
  // leave the real one running - holding the pipes the server is reading, so
  // the run it timed out on never comes back at all.
  for (const signal of ['SIGTERM', 'SIGINT', 'SIGHUP']) {
    process.on(signal, () => {
      child.kill(signal);
      setTimeout(() => child.kill('SIGKILL'), 3000).unref();
    });
  }

  child.on('error', error => {
    process.stderr.write(`harness: could not run ${real}: ${error.message}\n`);
    process.exit(127);
  });
  child.on('exit', (code, signal) => process.exit(signal ? 1 : (code ?? 0)));
};

if (!stateDir) {
  delegate();
  return;
}

appendFileSync(join(stateDir, 'calls.jsonl'), `${JSON.stringify(args)}\n`);

const planFile = join(stateDir, 'plan.json');
const plan = existsSync(planFile) ? JSON.parse(readFileSync(planFile, 'utf8')) : [];
const run = plan[0];
if (!run || (run.match && !args.join(' ').includes(run.match))) {
  delegate();
  return;
}
writeFileSync(planFile, JSON.stringify(plan.slice(1)));

const answer = () => {
  const write = () => {
    if (run.stderr) process.stderr.write(run.stderr);
    process.exit(run.exit ?? 0);
  };

  // A camera that accepts the connection and then says nothing, which is what
  // the server spends its whole ffmpeg timeout on.
  if (run.delayMs) setTimeout(write, run.delayMs);
  else write();
};

// A camera that says something on the wire: the bytes go to whatever `-i`
// points at, which is how a spec sees what the tunnel makes of them.
if (run.writeToInput) {
  const target = new URL(args[args.indexOf('-i') + 1]);
  const socket = connect(Number(target.port), target.hostname, () => {
    socket.write(new Uint8Array(Buffer.from(run.writeToInput, 'hex')));
    setTimeout(() => {
      socket.destroy();
      answer();
    }, 250);
  });
  socket.on('error', error => {
    process.stderr.write(`harness: could not reach ${target.host}: ${error.message}\n`);
    process.exit(1);
  });
} else {
  answer();
}
